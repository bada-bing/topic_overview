# Copy to .env and adjust. .env is not committed.

# Where discussions are kept, one git repository each.
TOPIC_OVERVIEW_DISCUSSIONS=~/.local/share/topic-overview/discussions

# The Logseq knowledge base whose pages a discussion links to.
TOPIC_OVERVIEW_KB=~/notes

# The GitLab hosts whose merge requests a page may show the state of,
# separated by commas. glab must be logged in to each.
TOPIC_OVERVIEW_GITLAB_HOSTS=gitlab.example.com

# The kubectl contexts whose deployments a discussion may show, separated
# by commas. Asking is read-only.
TOPIC_OVERVIEW_KUBE_CONTEXTS=example-cluster
