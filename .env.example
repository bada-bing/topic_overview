# Copy to .env and adjust. .env is not committed.

# Where discussions are kept, one git repository each.
TOPIC_OVERVIEW_DISCUSSIONS=~/.local/share/topic-overview/discussions

# The Logseq knowledge base whose pages a discussion links to.
TOPIC_OVERVIEW_KB=~/notes

# Where a discussion's worktree of the knowledge base is checked out, with its
# state beside it as <key>.json. Defaults to a folder worktrees beside the KB.
TOPIC_OVERVIEW_WORKTREES=~/worktrees

# The terminal app raised when the agent's tmux window is opened from the
# page, such as Ghostty. Left out, only tmux moves.
TOPIC_OVERVIEW_TERMINAL=Ghostty

# The GitLab hosts whose merge requests a page may show the state of,
# separated by commas. glab must be logged in to each.
TOPIC_OVERVIEW_GITLAB_HOSTS=gitlab.example.com

# The kubectl contexts whose deployments a discussion may show, separated
# by commas. Asking is read-only.
TOPIC_OVERVIEW_KUBE_CONTEXTS=example-cluster

# The Jenkins server whose jobs a discussion may show, and the user asked as.
# The token is read from JENKINS_API_TOKEN, or TOPIC_OVERVIEW_JENKINS_TOKEN.
TOPIC_OVERVIEW_JENKINS_URL=https://jenkins.example.com
TOPIC_OVERVIEW_JENKINS_USER=someone
