{
  "name": "topic_overview",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "pnpm --filter @topic-overview/web dev",
    "server": "pnpm --filter @topic-overview/server start",
    "build": "pnpm --filter @topic-overview/web build",
    "test": "pnpm --recursive test",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p packages/cli && tsc -p packages/web",
    "topic": "node --env-file-if-exists=.env packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
